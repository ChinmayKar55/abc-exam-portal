# ── Copy this to .env.production on your VPS — NEVER commit .env.production ──

# Database (postgres container)
DB_USER=abc_exam
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=abc_exam

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Auth
JWT_SECRET=CHANGE_ME_32_BYTES_RANDOM_HEX
JWT_EXPIRY_MIN=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Payment
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Gmail SMTP)
# Use an App Password, NOT your Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=abcsupportindia@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=abcsupportindia@gmail.com

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage

# Public URLs (must match your actual domains)
FRONTEND_URL=https://student.osssc.online
ADMIN_URL=https://admin.osssc.online
BACKEND_URL=https://api.osssc.online

# Container registry (GitHub Container Registry)
REGISTRY=ghcr.io/your-github-username-lowercase
API_TAG=latest
STUDENT_TAG=latest
ADMIN_TAG=latest
